@page "/Pages/Samples/Racks"
@rendermode InteractiveServer
@using BAL;
@using BAL.DTOs;
@using Global.Enums;
@using SampleTracker.Components.CommonComponents;
@inject SampleRackService SampleRackService
@inject NavigationManager NavigationManager


<PageTitle>RackConfigurationPage</PageTitle>

<h3 class="mb-3">Search Rack</h3>


<div class="mb-3">
    <label class="form-label">Rack Name</label>
    <InputText type="text" class="form-control" @bind-Value="RackName" />
</div>

<div class="mb-3">
    <label class="form-label">Rack Id</label>
    <InputNumber type="number" class="form-control" @bind-Value="RackId" />
</div>

<button type="button" class="btn btn-outline-secondary" @onclick="SearchRacks">Search</button>


@if (!HasLoaded && IsSearching)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
@if (HasLoaded)
{
    <div class="">
        <table class="table table-hover align-middle text-center ">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Cols</th>
                    <th scope="col">Rows</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rack in Racks)
                {
                    <tr>
                        <th>@rack.RackId</th>
                        <td>@rack.RackName</td>
                        <td>@rack.NumberOfColumns</td>
                        <td>@rack.NumberOfRows</td>
                        <td>
                            <button class=" btn btn-outline-secondary" @onclick="() => NavigationManager.NavigateTo(Url + rack.RackId)">
                                Edit
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>





}


