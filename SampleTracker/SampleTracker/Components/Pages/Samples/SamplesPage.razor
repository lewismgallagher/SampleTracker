@page "/Pages/Samples/{RackId}"

@rendermode InteractiveServer
@using Services;
@using Services.DTOs;
@using Global.Enums;
@using SampleTracker.Components.CommonComponents;
@inject SampleRackService SampleRackService
@inject NavigationManager NavigationManager



@if (!HasLoaded)
{
    <div class="col">
    <h3 class="row">Samples </h3>
    <h5 class="row">Rack Id: @RackId </h5>
    </div>

    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else
{
    <div class="">
        <h3 class="col-12">Samples </h3>
        <h5 class="col-12">RackName: @Rack.RackName. Rack Id: @RackId </h5>
    </div>

    <div class="row">
        <label class="  mt-auto mb-auto col-2 form-label">Select Sample Type:</label>
        <select class="mt-auto mb-auto col-3 dropdown dropdown-header" @bind="SelectedSampleTypeId">

        @foreach (var st in SampleTypes)
        {
            <option value="@st.Id"> @st.Name</option>
        }

    </select>
    </div>

    <div class="">
        <table class="table table-hover align-middle text-center ">
            <thead>
                <tr>
                    <th scope="col"></th>

                    @for (int i = 1; i < Rack.NumberOfColumns + 1; i++)
                    {
                        <th scope="col">@i</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int r = 1; r < Rack.NumberOfRows + 1; r++)
                {
                    <tr>
                        <th scope="row">@r</th>
                        @for (int c = 1; c < Rack.NumberOfColumns + 1; c++)
                        {
                            <th scope="row">
                                    <SampleTextBox Finished="SaveSample" Sample="GetSample(c,r)" ></SampleTextBox>
                            </th>
                        }
                    </tr>
                }

            </tbody>
        </table>
    </div>


}
