@rendermode InteractiveServer
@using Services;
@using Services.DTOs;
@using Global.Enums;
@using SampleTracker.Components.CommonComponents;


<div class="mb-auto" >
    <Tooltip Text="@Sample.SampleType">
        <InputText  type="text" class=" form-control"
                       @onmouseover="ShowSampleType" @onmouseout="HideSampleType"
                       @onfocusout="() => Finished.InvokeAsync(Sample)" @onfocusin="SetOriginalValue"
                       @bind-Value="Sample.IdentifyingValue" />
    </Tooltip>


</div>

@code {


    [Parameter]
    public SampleDTO Sample { get; set; }


    public string OriginalValue { get; set; }

    [Parameter]
    public EventCallback<SampleDTO> Finished { get; set; }

    public bool SampleTypeVisible { get; set; }

    public void SetOriginalValue()
    {
        OriginalValue = Sample.IdentifyingValue;
    }

    public void ShowSampleType()
    {
        if (string.IsNullOrWhiteSpace(Sample.SampleType) == false)
        {
            SampleTypeVisible = true;
        }
    }

    public void HideSampleType()
    {
        SampleTypeVisible = false;
    }

}
