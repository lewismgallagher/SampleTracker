@rendermode InteractiveServer
@using BAL;
@using BAL.DTOs;
@using Global.Enums;
@using SampleTracker.Components.CommonComponents;


<div class="mb-3">
    <InputText type="text" class=" form-control"
     @onfocusout="Save" @bind-Value="Sample.IdentifyingValue" />
</div>

@code {
    [Parameter]
    public SampleDTO SampleToEdit { get; set; }
    [Parameter]
    public SampleTypeDTO SampleType { get; set; }

    public SampleDTO Sample { get; set; }




    public bool HasSaved { get; set; }
    //TODO fix sample type being lost on existing values.

    protected override void OnInitialized()
    {
        Sample = new SampleDTO();


        if (SampleToEdit != null) { Sample = SampleToEdit; }
    }


    public void Save()
    {
        var sam = SampleType;
        HasSaved = true;
    }
}
